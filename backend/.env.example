# geo-spatial-center 后端环境变量
# 复制为 .env 后修改

PORT=3002

# Docker 内通过服务名访问共享 PostgreSQL（端口统一为 5432）
DATABASE_URL=postgres://geo_spatial:geo_dev@localhost:5432/geo_spatial

# 与主中心通信的内部 API 密钥（两端保持一致）
MAIN_CENTER_API_KEY=geo-spatial-internal-key-2026

# 主中心回调地址（分中心审批后向主中心回传结果）
# Docker Compose 中使用 http://jiangsu-backend:3001/api/internal/subcenter-callback
MAIN_CENTER_CALLBACK_URL=http://localhost:3001/api/internal/subcenter-callback
